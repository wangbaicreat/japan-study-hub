# --- Required for the best experience -------------------------------
# Free key: https://openalex.org/settings/api  (raises daily budget)
OPENALEX_KEY=

# --- Optional: Chinese summaries / titles ---------------------------
# Any OpenAI-compatible endpoint works. DeepSeek is the cheap default.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- Optional: Korean coverage --------------------------------------
# Request a key at https://openci.kci.go.kr (KCI Open API)
KCI_API_KEY=

# --- Optional: Japanese coverage ------------------------------------
# CiNii Research / NDL Search application IDs
CINII_APPID=
NDL_APPID=

# --- Optional: email delivery ---------------------------------------
# buttondown | resend | dry-run (default: dry-run writes .eml to data/outbox/)
EMAIL_PROVIDER=dry-run
BUTTONDOWN_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=digest@example.com
EMAIL_TO=

# --- Optional: institutional JSTOR SRU gateway ----------------------
# Only available to institutions with a JSTOR Metasearch License.
JSTOR_SRU_URL=
JSTOR_SRU_USER=
JSTOR_SRU_PASS=
